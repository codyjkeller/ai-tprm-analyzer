# Copy this file to .env and fill in only what you need.
# With nothing set, the tool runs offline and sends no data anywhere.

# --- AI review (optional) ---
# Setting a key does not switch AI review on. You also have to pass
# --provider on the command line or set TPRM_PROVIDER below.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# rules (offline, default) | anthropic | openai | azure | openai-compatible
TPRM_PROVIDER=

# Model name. Anthropic defaults to claude-sonnet-5-5. The others have no
# default: set the model (for Azure, the deployment name) your account uses.
TPRM_MODEL=

# Azure OpenAI (--provider azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OPENAI_API_VERSION=

# Any service that speaks the OpenAI chat API (--provider openai-compatible):
# a company AI gateway, or a model hosted on your own network.
TPRM_BASE_URL=
TPRM_API_KEY=

# --- Connections (optional, each used only when you ask for it) ---
# Slack: an incoming-webhook address for one channel. Treat it as a secret.
SLACK_WEBHOOK_URL=

# Atlassian Cloud (Jira and Confluence). Use an API token, not your password.
ATLASSIAN_BASE_URL=
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
JIRA_PROJECT_KEY=
# JIRA_ISSUE_TYPE=Task

# Largest vendor document accepted, in characters (default 400000).
# TPRM_MAX_CHARS=400000
